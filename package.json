{
  "name": "excel-mcp-requests",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "mcp:tools": "node --env-file-if-exists=.env.local --import tsx scripts/workbook.ts tools",
    "excel:init": "node --env-file-if-exists=.env.local --import tsx scripts/workbook.ts init",
    "excel:reset": "node --env-file-if-exists=.env.local --import tsx scripts/workbook.ts reset",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/golos-text": "5.3.0",
    "@fontsource-variable/roboto-condensed": "5.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "lucide-react": "1.76.0",
    "next": "16.4.6",
    "openai": "7.62.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.22.1",
    "typescript": "5.9.3"
  }
}
